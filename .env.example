# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# Required: OpenAI API key used by generate_user_profile/ and process_attributes/
OPENAI_API_KEY=sk-...

# Optional: GeoNames username. Free signup at https://www.geonames.org/login
# The default "demo" account is rate-limited and unreliable for real runs.
GEONAMES_USERNAME=demo
